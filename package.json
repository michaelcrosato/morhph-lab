{
  "name": "morph-lab",
  "version": "12.0.0",
  "private": true,
  "type": "module",
  "description": "Discovery-first procedural monster creator: seeded rolls, locked traits, saved parents, mixing, and complete asset delivery.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs --cdn",
    "build:offline": "node scripts/build.mjs --offline",
    "test": "node --test \"tests/*.test.js\"",
    "test:engine": "node --test \"tests/engine/*.test.js\"",
    "test:examples": "node scripts/validate-examples.mjs && node scripts/examples.mjs --check",
    "test:geometry": "node scripts/geometry-regression.mjs",
    "test:catalog": "node scripts/catalog-review.mjs && node scripts/check-catalog-delivery.mjs",
    "test:ui": "npm run build && python3 scripts/test-browser-regression.py",
    "test:import": "node scripts/delivery-samples.mjs && node scripts/packing-samples.mjs && python3 tests/delivery_import.py && python3 tests/packing_import.py",
    "test:shaders": "python3 tests/shader_smoke.py",
    "test:gpu": "npm run build:offline && python3 tests/review_gpu.py",
    "check": "npm run lint && npm test && npm run test:engine && npm run test:examples && npm run test:geometry && npm run test:catalog",
    "examples": "node scripts/examples.mjs",
    "review": "node scripts/review.mjs",
    "review:catalog": "node scripts/catalog-review.mjs --render",
    "swatches": "node scripts/surface-swatches.mjs",
    "audit:library": "node scripts/library-audit.mjs",
    "export:asset": "node scripts/export-asset.mjs",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write . && ruff format tests scripts",
    "lint": "prettier --check . && ruff format --check tests scripts && ruff check --select F,E9 tests scripts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.181.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "3.8.4"
  }
}
